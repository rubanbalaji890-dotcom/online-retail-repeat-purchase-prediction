        "# ============================================================\n",
        "# Step 16: Create stratified train-test split\n",
        "# ============================================================\n",
        "\n",
        "# Final predictor variables after multicollinearity assessment\n",
        "final_features = [\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"MonetaryValue\",\n",
        "    \"UniqueProducts\",\n",
        "    \"AverageOrderValue\"\n",
        "]\n",
        "\n",
        "target = \"RepeatPurchase90D\"\n",
        "\n",
        "# Predictor matrix and target vector\n",
        "X = model_df[final_features].copy()\n",
        "y = model_df[target].copy()\n",
        "\n",
        "print(\"FULL MODELLING DATASET\")\n",
