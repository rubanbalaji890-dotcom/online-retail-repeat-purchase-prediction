      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 20: Gradient Boosting Classifier\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.ensemble import GradientBoostingClassifier\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Initialise Gradient Boosting model\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_model = GradientBoostingClassifier(\n",
        "    n_estimators=100,\n",
        "    learning_rate=0.05,\n",
        "    max_depth=3,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Train model\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_model.fit(\n",
        "    X_train_scaled,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Generate predictions\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_predictions = gb_model.predict(\n",
        "    X_test_scaled\n",
        ")\n",
        "\n",
        "gb_probabilities = gb_model.predict_proba(\n",
        "    X_test_scaled\n",
        ")[:, 1]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Calculate performance metrics\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_accuracy = accuracy_score(\n",
        "    y_test,\n",
        "    gb_predictions\n",
        ")\n",
        "\n",
        "gb_precision = precision_score(\n",
        "    y_test,\n",
        "    gb_predictions\n",
        ")\n",
        "\n",
        "gb_recall = recall_score(\n",
        "    y_test,\n",
        "    gb_predictions\n",
        ")\n",
        "\n",
        "gb_f1 = f1_score(\n",
        "    y_test,\n",
        "    gb_predictions\n",
        ")\n",
        "\n",
        "gb_roc_auc = roc_auc_score(\n",
        "    y_test,\n",
        "    gb_probabilities\n",
        ")\n",
        "\n",
        "\n",
        "print(\"GRADIENT BOOSTING — TEST PERFORMANCE\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"Accuracy:  {gb_accuracy:.4f}\")\n",
        "print(f\"Precision: {gb_precision:.4f}\")\n",
        "print(f\"Recall:    {gb_recall:.4f}\")\n",
        "print(f\"F1-score:  {gb_f1:.4f}\")\n",
        "print(f\"ROC-AUC:   {gb_roc_auc:.4f}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Confusion matrix\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_cm = confusion_matrix(\n",
        "    y_test,\n",
        "    gb_predictions\n",
        ")\n",
        "\n",
        "gb_cm_df = pd.DataFrame(\n",
        "    gb_cm,\n",
        "    index=[\n",
        "        \"Actual Non-Repeat\",\n",
        "        \"Actual Repeat\"\n",
        "    ],\n",
        "    columns=[\n",
        "        \"Predicted Non-Repeat\",\n",
        "        \"Predicted Repeat\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"\\nCONFUSION MATRIX\")\n",
        "print(\"-\" * 45)\n",
        "\n",
        "display(gb_cm_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Classification report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nCLASSIFICATION REPORT\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(\n",
        "    classification_report(\n",
        "        y_test,\n",
        "        gb_predictions,\n",
        "        target_names=[\n",
        "            \"Non-Repeat\",\n",
        "            \"Repeat\"\n",
        "        ],\n",
        "        digits=4\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Gradient Boosting feature importance\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_importance = pd.DataFrame({\n",
        "    \"Feature\": final_features,\n",
        "    \"Importance\": gb_model.feature_importances_\n",
        "})\n",
        "\n",
        "gb_importance = gb_importance.sort_values(\n",
        "    \"Importance\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(\"\\nGRADIENT BOOSTING FEATURE IMPORTANCE\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "display(\n",
        "    gb_importance.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Compare all three models\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model_comparison_3 = pd.DataFrame({\n",
        "    \"Model\": [\n",
        "        \"Logistic Regression\",\n",
        "        \"Random Forest\",\n",
        "        \"Gradient Boosting\"\n",
        "    ],\n",
        "\n",
        "    \"Accuracy\": [\n",
        "        log_accuracy,\n",
        "        rf_accuracy,\n",
        "        gb_accuracy\n",
        "    ],\n",
        "\n",
        "    \"Precision\": [\n",
        "        log_precision,\n",
        "        rf_precision,\n",
        "        gb_precision\n",
        "    ],\n",
        "\n",
        "    \"Recall\": [\n",
        "        log_recall,\n",
        "        rf_recall,\n",
        "        gb_recall\n",
        "    ],\n",
        "\n",
        "    \"F1\": [\n",
        "        log_f1,\n",
        "        rf_f1,\n",
        "        gb_f1\n",
        "    ],\n",
        "\n",
        "    \"ROC_AUC\": [\n",
        "        log_roc_auc,\n",
        "        rf_roc_auc,\n",
        "        gb_roc_auc\n",
        "    ]\n",
        "})\n",
        "\n",
        "\n",
        "print(\"\\nTHREE-MODEL PERFORMANCE COMPARISON\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "display(\n",
        "    model_comparison_3.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Identify best-performing model by ROC-AUC\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "best_model_row = model_comparison_3.loc[\n",
        "    model_comparison_3[\"ROC_AUC\"].idxmax()\n",
        "]\n",
        "\n",
        "print(\"\\nCURRENT BEST MODEL\")\n",
        "print(\"-\" * 45)\n",
        "\n",
        "print(\n",
        "    \"Model:\",\n",
        "    best_model_row[\"Model\"]\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"ROC-AUC:\",\n",
        "    round(best_model_row[\"ROC_AUC\"], 4)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Accuracy:\",\n",
        "    round(best_model_row[\"Accuracy\"], 4)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"F1-score:\",\n",
        "    round(best_model_row[\"F1\"], 4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Prediction integrity check\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nGRADIENT BOOSTING PREDICTION CHECK\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "print(\n",
        "    \"Test customers:\",\n",
        "    len(y_test)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Predicted repeat purchasers:\",\n",
        "    int((gb_predictions == 1).sum())\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Predicted non-repeat purchasers:\",\n",
        "    int((gb_predictions == 0).sum())\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Prediction probability range:\",\n",
        "    round(gb_probabilities.min(), 4),\n",
        "    \"to\",\n",
        "    round(gb_probabilities.max(), 4)\n",
        ")\n",
        "\n",
        "print(\"\\nGradient Boosting completed successfully.\")"
      ],
