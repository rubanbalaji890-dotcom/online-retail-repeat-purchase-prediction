        "# ============================================================\n",
        "# Step 18: Baseline Logistic Regression\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Initialise and train model\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "logistic_model = LogisticRegression(\n",
        "    random_state=42,\n",
        "    max_iter=1000\n",
        ")\n",
        "\n",
        "logistic_model.fit(\n",
        "    X_train_scaled,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Generate test predictions\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "logistic_predictions = logistic_model.predict(\n",
        "    X_test_scaled\n",
        ")\n",
        "\n",
        "logistic_probabilities = logistic_model.predict_proba(\n",
        "    X_test_scaled\n",
        ")[:, 1]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Calculate evaluation metrics\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "log_accuracy = accuracy_score(\n",
        "    y_test,\n",
        "    logistic_predictions\n",
        ")\n",
        "\n",
        "log_precision = precision_score(\n",
        "    y_test,\n",
        "    logistic_predictions\n",
        ")\n",
        "\n",
        "log_recall = recall_score(\n",
        "    y_test,\n",
        "    logistic_predictions\n",
        ")\n",
        "\n",
        "log_f1 = f1_score(\n",
        "    y_test,\n",
        "    logistic_predictions\n",
        ")\n",
        "\n",
        "log_roc_auc = roc_auc_score(\n",
        "    y_test,\n",
        "    logistic_probabilities\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Display performance\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"BASELINE LOGISTIC REGRESSION — TEST PERFORMANCE\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"Accuracy:  {log_accuracy:.4f}\")\n",
        "print(f\"Precision: {log_precision:.4f}\")\n",
        "print(f\"Recall:    {log_recall:.4f}\")\n",
        "print(f\"F1-score:  {log_f1:.4f}\")\n",
        "print(f\"ROC-AUC:   {log_roc_auc:.4f}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Confusion matrix\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "log_cm = confusion_matrix(\n",
        "    y_test,\n",
        "    logistic_predictions\n",
        ")\n",
        "\n",
        "print(\"\\nCONFUSION MATRIX\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "log_cm_df = pd.DataFrame(\n",
        "    log_cm,\n",
        "    index=[\n",
        "        \"Actual Non-Repeat\",\n",
        "        \"Actual Repeat\"\n",
        "    ],\n",
        "    columns=[\n",
        "        \"Predicted Non-Repeat\",\n",
        "        \"Predicted Repeat\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "display(log_cm_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Classification report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nCLASSIFICATION REPORT\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(\n",
        "    classification_report(\n",
        "        y_test,\n",
        "        logistic_predictions,\n",
        "        target_names=[\n",
        "            \"Non-Repeat\",\n",
        "            \"Repeat\"\n",
        "        ],\n",
        "        digits=4\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Logistic regression coefficients\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "coefficient_table = pd.DataFrame({\n",
        "    \"Feature\": final_features,\n",
        "    \"Coefficient\": logistic_model.coef_[0]\n",
        "})\n",
        "\n",
        "coefficient_table[\"AbsoluteCoefficient\"] = (\n",
        "    coefficient_table[\"Coefficient\"].abs()\n",
        ")\n",
        "\n",
        "coefficient_table = coefficient_table.sort_values(\n",
        "    \"AbsoluteCoefficient\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(\"\\nLOGISTIC REGRESSION COEFFICIENTS\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "display(\n",
        "    coefficient_table[\n",
        "        [\"Feature\", \"Coefficient\"]\n",
        "    ].round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Basic prediction checks\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nPREDICTION CHECK\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(\"Test customers:\", len(y_test))\n",
        "\n",
        "print(\n",
        "    \"Predicted repeat purchasers:\",\n",
        "    int((logistic_predictions == 1).sum())\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Predicted non-repeat purchasers:\",\n",
        "    int((logistic_predictions == 0).sum())\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Prediction probability range:\",\n",
        "    round(logistic_probabilities.min(), 4),\n",
        "    \"to\",\n",
        "    round(logistic_probabilities.max(), 4)\n",
        ")\n",
        "\n",
        "print(\"\\nBaseline Logistic Regression completed successfully.\")"
      ],
