      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 10: RFM and behavioural feature engineering\n",
        "# ============================================================\n",
        "\n",
        "# Use the end of the observation period as the reference date\n",
        "reference_date = observation_df[\"InvoiceDate\"].max()\n",
        "\n",
        "# Create transaction revenue\n",
        "observation_df = observation_df.copy()\n",
        "observation_df[\"TotalPrice\"] = (\n",
        "    observation_df[\"Quantity\"] * observation_df[\"UnitPrice\"]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Customer-level RFM and behavioural features\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "customer_features = (\n",
        "    observation_df\n",
        "    .groupby(\"CustomerID\")\n",
        "    .agg(\n",
        "        LastPurchase=(\"InvoiceDate\", \"max\"),\n",
        "        Frequency=(\"InvoiceNo\", \"nunique\"),\n",
        "        MonetaryValue=(\"TotalPrice\", \"sum\"),\n",
        "        UniqueProducts=(\"StockCode\", \"nunique\"),\n",
        "        TotalItems=(\"Quantity\", \"sum\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Recency = days since customer's most recent purchase\n",
        "customer_features[\"Recency\"] = (\n",
        "    reference_date - customer_features[\"LastPurchase\"]\n",
        ").dt.days\n",
        "\n",
        "# Average order value\n",
        "customer_features[\"AverageOrderValue\"] = (\n",
        "    customer_features[\"MonetaryValue\"] /\n",
        "    customer_features[\"Frequency\"]\n",
        ")\n",
        "\n",
        "# Average basket size\n",
        "customer_features[\"BasketSize\"] = (\n",
        "    customer_features[\"TotalItems\"] /\n",
        "    customer_features[\"Frequency\"]\n",
        ")\n",
        "\n",
        "# Remove helper columns that are not required as predictors\n",
        "customer_features = customer_features[\n",
        "    [\n",
        "        \"CustomerID\",\n",
        "        \"Recency\",\n",
        "        \"Frequency\",\n",
        "        \"MonetaryValue\",\n",
        "        \"UniqueProducts\",\n",
        "        \"AverageOrderValue\",\n",
        "        \"BasketSize\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "print(\"CUSTOMER FEATURE ENGINEERING\")\n",
        "print(\"-\" * 45)\n",
        "\n",
        "print(\"Reference date:\", reference_date)\n",
        "\n",
        "print(\"\\nNumber of customers:\",\n",
        "      len(customer_features))\n",
        "\n",
        "print(\"\\nPredictor variables:\")\n",
        "print(customer_features.columns.tolist())\n",
        "\n",
        "print(\"\\nFirst five customer records:\")\n",
        "display(customer_features.head())\n",
        "\n",
        "print(\"\\nFeature summary:\")\n",
        "display(\n",
        "    customer_features[\n",
        "        [\n",
        "            \"Recency\",\n",
        "            \"Frequency\",\n",
        "            \"MonetaryValue\",\n",
        "            \"UniqueProducts\",\n",
        "            \"AverageOrderValue\",\n",
        "            \"BasketSize\"\n",
        "        ]\n",
        "    ].describe().round(2)\n",
        ")"
      ],
