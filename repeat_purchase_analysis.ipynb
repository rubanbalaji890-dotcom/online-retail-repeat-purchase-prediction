        "# ============================================================\n",
        "# STEP 23: FINAL EVALUATION ON THE UNTOUCHED TEST SET\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score,\n",
        "    confusion_matrix,\n",
        "    classification_report\n",
        ")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"FINAL TEST-SET EVALUATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Use the best Logistic Regression model from tuning\n",
        "# ------------------------------------------------------------\n",
        "final_model = best_logistic_model\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Make predictions on the untouched test set\n",
        "# ------------------------------------------------------------\n",
        "final_predictions = final_model.predict(X_test)\n",
        "\n",
        "final_probabilities = final_model.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Calculate final performance metrics\n",
        "# ------------------------------------------------------------\n",
        "final_accuracy = accuracy_score(y_test, final_predictions)\n",
        "\n",
        "final_precision = precision_score(\n",
        "    y_test,\n",
        "    final_predictions,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "final_recall = recall_score(\n",
        "    y_test,\n",
        "    final_predictions,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "final_f1 = f1_score(\n",
        "    y_test,\n",
        "    final_predictions,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "final_roc_auc = roc_auc_score(\n",
        "    y_test,\n",
        "    final_probabilities\n",
        ")\n",
        "\n",
