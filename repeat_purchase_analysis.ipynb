        "print((y.value_counts(normalize=True) * 100).round(2))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Stratified 80/20 train-test split\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
