        "# ============================================================\n",
        "# Step 13: Correlation and multicollinearity assessment\n",
        "# ============================================================\n",
        "\n",
        "feature_cols = [\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"MonetaryValue\",\n",
        "    \"UniqueProducts\",\n",
        "    \"AverageOrderValue\",\n",
        "    \"BasketSize\"\n",
        "]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Pearson correlation matrix\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "correlation_matrix = model_df[feature_cols].corr()\n",
        "\n",
        "print(\"CORRELATION AND MULTICOLLINEARITY ASSESSMENT\")\n",
        "print(\"-\" * 55)\n",
        "\n",
        "print(\"\\nPearson correlation matrix:\")\n",
        "display(correlation_matrix.round(3))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Correlation heatmap\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 7))\n",
        "\n",
        "plt.imshow(\n",
        "    correlation_matrix,\n",
        "    cmap=\"coolwarm\",\n",
        "    vmin=-1,\n",
        "    vmax=1\n",
        ")\n",
        "\n",
        "plt.colorbar(label=\"Correlation\")\n",
        "\n",
        "plt.xticks(\n",
        "    range(len(feature_cols)),\n",
        "    feature_cols,\n",
        "    rotation=45,\n",
        "    ha=\"right\"\n",
        ")\n",
        "\n",
        "plt.yticks(\n",
        "    range(len(feature_cols)),\n",
        "    feature_cols\n",
        ")\n",
        "\n",
        "for i in range(len(feature_cols)):\n",
        "    for j in range(len(feature_cols)):\n",
        "        plt.text(\n",
        "            j,\n",
        "            i,\n",
        "            f\"{correlation_matrix.iloc[i, j]:.2f}\",\n",
        "            ha=\"center\",\n",
        "            va=\"center\"\n",
        "        )\n",
        "\n",
        "plt.title(\"Correlation Matrix of Predictor Variables\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Identify highly correlated predictor pairs\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nHighly correlated predictor pairs (|r| >= 0.70):\")\n",
        "\n",
        "high_corr_found = False\n",
        "\n",
        "for i in range(len(feature_cols)):\n",
        "    for j in range(i + 1, len(feature_cols)):\n",
        "\n",
        "        corr_value = correlation_matrix.iloc[i, j]\n",
        "\n",
        "        if abs(corr_value) >= 0.70:\n",
        "            print(\n",
        "                f\"{feature_cols[i]} vs {feature_cols[j]}: \"\n",
        "                f\"{corr_value:.3f}\"\n",
        "            )\n",
        "            high_corr_found = True\n",
        "\n",
        "if not high_corr_found:\n",
        "    print(\"No predictor pairs have |r| >= 0.70.\")"
      ],
