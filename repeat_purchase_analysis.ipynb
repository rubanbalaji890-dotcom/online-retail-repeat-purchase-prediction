      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 14: Variance Inflation Factor (VIF) assessment\n",
        "# ============================================================\n",
        "\n",
        "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
        "from statsmodels.tools.tools import add_constant\n",
        "\n",
        "vif_features = [\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"MonetaryValue\",\n",
        "    \"UniqueProducts\",\n",
        "    \"AverageOrderValue\",\n",
        "    \"BasketSize\"\n",
        "]\n",
        "\n",
        "# Create predictor matrix\n",
        "X_vif = model_df[vif_features].copy()\n",
        "\n",
        "# Add intercept\n",
        "X_vif_const = add_constant(X_vif)\n",
        "\n",
        "# Calculate VIF\n",
        "vif_results = pd.DataFrame()\n",
        "\n",
        "vif_results[\"Feature\"] = X_vif_const.columns\n",
        "\n",
        "vif_results[\"VIF\"] = [\n",
        "    variance_inflation_factor(X_vif_const.values, i)\n",
        "    for i in range(X_vif_const.shape[1])\n",
        "]\n",
        "\n",
        "# Remove intercept from displayed results\n",
        "vif_results = vif_results[\n",
        "    vif_results[\"Feature\"] != \"const\"\n",
        "].copy()\n",
        "\n",
        "vif_results = vif_results.sort_values(\n",
        "    \"VIF\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(\"VARIANCE INFLATION FACTOR (VIF) ASSESSMENT\")\n",
        "print(\"-\" * 55)\n",
        "\n",
        "display(vif_results.round(3))\n",
        "\n",
        "\n",
        "# Interpretation\n",
        "print(\"\\nVIF interpretation:\")\n",
        "\n",
        "for _, row in vif_results.iterrows():\n",
        "\n",
        "    feature = row[\"Feature\"]\n",
        "    vif = row[\"VIF\"]\n",
        "\n",
        "    if vif >= 10:\n",
        "        status = \"Severe multicollinearity\"\n",
        "    elif vif >= 5:\n",
        "        status = \"Potentially problematic multicollinearity\"\n",
        "    else:\n",
        "        status = \"Acceptable\"\n",
        "\n",
        "    print(f\"{feature}: {vif:.3f} -> {status}\")"
      ],
