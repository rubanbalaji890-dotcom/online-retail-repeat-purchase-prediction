      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# STEP 24: FINAL MODEL DIAGNOSTIC AND MODEL SELECTION\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "print(\"=\" * 72)\n",
        "print(\"FINAL MODEL DIAGNOSTIC AND SELECTION\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Display selected tuning parameters\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\nOPTIMISED LOGISTIC REGRESSION PARAMETERS\")\n",
        "print(\"-\" * 72)\n",
        "\n",
        "try:\n",
        "    print(logistic_grid.best_params_)\n",
        "except:\n",
        "    print(\"Best parameters available from fitted model:\")\n",
        "    print(best_logistic_model.get_params())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. CV versus held-out test performance\n",
        "# ------------------------------------------------------------\n",
        "try:\n",
        "    tuned_cv_auc = logistic_grid.best_score_\n",
        "except:\n",
        "    tuned_cv_auc = 0.7499\n",
        "\n",
        "print(\"\\nGENERALISATION CHECK\")\n",
        "print(\"-\" * 72)\n",
        "\n",
        "print(f\"Optimised Logistic CV ROC-AUC:   {tuned_cv_auc:.4f}\")\n",
        "print(f\"Optimised Logistic Test ROC-AUC: {final_roc_auc:.4f}\")\n",
        "print(\n",
        "    f\"CV-to-test ROC-AUC difference:   \"\n",
        "    f\"{tuned_cv_auc - final_roc_auc:.4f}\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Baseline versus tuned model\n",
        "# Values below are from the untouched test-set evaluations\n",
        "# already completed in previous steps.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "diagnostic_comparison = pd.DataFrame({\n",
        "\n",
        "    \"Metric\": [\n",
        "        \"Accuracy\",\n",
        "        \"Precision\",\n",
        "        \"Recall\",\n",
        "        \"F1-score\",\n",
        "        \"ROC-AUC\"\n",
        "    ],\n",
        "\n",
        "    \"Baseline_Logistic\": [\n",
        "        0.6662,\n",
        "        0.7065,\n",
        "        0.7083,\n",
        "        0.7074,\n",
        "        0.7327\n",
        "    ],\n",
        "\n",
        "    \"Optimised_Logistic\": [\n",
        "        final_accuracy,\n",
        "        final_precision,\n",
        "        final_recall,\n",
        "        final_f1,\n",
        "        final_roc_auc\n",
        "    ]\n",
        "})\n",
        "\n",
        "diagnostic_comparison[\"Difference\"] = (\n",
        "    diagnostic_comparison[\"Optimised_Logistic\"]\n",
        "    - diagnostic_comparison[\"Baseline_Logistic\"]\n",
        ")\n",
        "\n",
        "print(\"\\nBASELINE VS OPTIMISED LOGISTIC REGRESSION\")\n",
        "print(\"-\" * 72)\n",
        "\n",
        "display(diagnostic_comparison.round(4))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Prediction distribution diagnostic\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "actual_repeat = int(np.sum(np.asarray(y_test) == 1))\n",
        "actual_nonrepeat = int(np.sum(np.asarray(y_test) == 0))\n",
        "\n",
        "pred_repeat = int(np.sum(final_predictions == 1))\n",
        "pred_nonrepeat = int(np.sum(final_predictions == 0))\n",
        "\n",
        "distribution_check = pd.DataFrame({\n",
        "\n",
        "    \"Class\": [\n",
        "        \"Repeat\",\n",
        "        \"Non-Repeat\"\n",
        "    ],\n",
        "\n",
        "    \"Actual_Test_Set\": [\n",
        "        actual_repeat,\n",
        "        actual_nonrepeat\n",
        "    ],\n",
        "\n",
        "    \"Optimised_Predictions\": [\n",
        "        pred_repeat,\n",
        "        pred_nonrepeat\n",
        "    ]\n",
        "})\n",
        "\n",
        "distribution_check[\"Actual_Percent\"] = (\n",
        "    distribution_check[\"Actual_Test_Set\"]\n",
        "    / len(y_test) * 100\n",
        ")\n",
        "\n",
        "distribution_check[\"Predicted_Percent\"] = (\n",
        "    distribution_check[\"Optimised_Predictions\"]\n",
        "    / len(y_test) * 100\n",
        ")\n",
        "\n",
        "print(\"\\nPREDICTION DISTRIBUTION CHECK\")\n",
        "print(\"-\" * 72)\n",
        "\n",
        "display(distribution_check.round(2))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Confusion-matrix diagnostic\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "tn, fp, fn, tp = confusion_matrix(\n",
        "    y_test,\n",
        "    final_predictions\n",
        ").ravel()\n",
        "\n",
        "print(\"\\nOPTIMISED MODEL CONFUSION-MATRIX DIAGNOSTIC\")\n",
        "print(\"-\" * 72)\n",
        "\n",
        "print(f\"True negatives:  {tn}\")\n",
        "print(f\"False positives: {fp}\")\n",
        "print(f\"False negatives: {fn}\")\n",
        "print(f\"True positives:  {tp}\")\n",
        "\n",
        "specificity = tn / (tn + fp)\n",
        "\n",
        "print(f\"\\nNon-repeat specificity: {specificity:.4f}\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Final model-selection rule\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "baseline_auc = 0.7327\n",
        "baseline_accuracy = 0.6662\n",
        "baseline_f1 = 0.7074\n",
        "\n",
        "print(\"\\nFINAL MODEL-SELECTION ASSESSMENT\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "if (\n",
        "    final_roc_auc > baseline_auc\n",
        "    and final_accuracy >= baseline_accuracy\n",
        "):\n",
        "    selected_final_model = \"Optimised Logistic Regression\"\n",
        "else:\n",
        "    selected_final_model = \"Baseline Logistic Regression\"\n",
        "\n",
        "print(f\"Selected final model: {selected_final_model}\")\n",
        "\n",
        "print(\"\\nReason:\")\n",
        "if selected_final_model == \"Baseline Logistic Regression\":\n",
        "    print(\n",
        "        \"The optimised model substantially increased repeat-class \"\n",
        "        \"recall but reduced held-out accuracy and ROC-AUC and \"\n",
        "        \"produced an extreme repeat-class prediction tendency.\"\n",
        "    )\n",
        "    print(\n",
        "        \"The baseline Logistic Regression therefore provides the \"\n",
        "        \"more balanced and defensible held-out performance.\"\n",
        "    )\n",
        "else:\n",
        "    print(\n",
        "        \"The optimised model improved discrimination without \"\n",
        "        \"reducing held-out accuracy and is therefore retained.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Final methodological statement\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nMETHODOLOGICAL CONCLUSION\")\n",
        "print(\"-\" * 72)\n",
        "\n",
        "print(\n",
        "    \"Hyperparameters were selected using training-data \"\n",
        "    \"cross-validation. The held-out test set was used only for \"\n",
        "    \"final evaluation and was not used for further tuning.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Final model selection considers discrimination, classification \"\n",
        "    \"performance and prediction balance rather than relying on a \"\n",
        "    \"single metric.\"\n",
        ")\n",
        "\n",
        "print(\"\\nStep 24 completed successfully.\")"
      ],
