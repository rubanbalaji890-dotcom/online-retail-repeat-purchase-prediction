        "# ============================================================\n",
        "# STEP 26: FINAL RESULTS SUMMARY AND BUSINESS INTERPRETATION\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"FINAL RESULTS SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Final modelling summary\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "final_model_summary = pd.DataFrame({\n",
        "\n",
        "    \"Measure\": [\n",
        "        \"Original transactions\",\n",
        "        \"Cleaned transactions\",\n",
        "        \"Cleaned customers\",\n",
        "        \"Eligible modelling customers\",\n",
        "        \"Repeat purchasers\",\n",
        "        \"Non-repeat purchasers\",\n",
        "        \"Training customers\",\n",
        "        \"Testing customers\",\n",
        "        \"Final selected model\"\n",
        "    ],\n",
        "\n",
        "    \"Result\": [\n",
        "        541909,\n",
        "        392692,\n",
        "        4338,\n",
        "        3370,\n",
        "        1921,\n",
        "        1449,\n",
        "        2696,\n",
        "        674,\n",
        "        \"Baseline Logistic Regression\"\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nDATA AND MODELLING SUMMARY\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "display(final_model_summary)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Final baseline model comparison\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "final_performance_summary = pd.DataFrame({\n",
        "\n",
        "    \"Model\": [\n",
        "        \"Logistic Regression\",\n",
        "        \"Random Forest\",\n",
        "        \"Gradient Boosting\"\n",
        "    ],\n",
        "\n",
        "    \"Accuracy\": [\n",
        "        0.6662,\n",
        "        0.6543,\n",
        "        0.6766\n",
        "    ],\n",
        "\n",
        "    \"Precision\": [\n",
        "        0.7065,\n",
        "        0.7068,\n",
        "        0.7196\n",
        "    ],\n",
        "\n",
        "    \"Recall\": [\n",
        "        0.7083,\n",
        "        0.6719,\n",
        "        0.7083\n",
        "    ],\n",
        "\n",
        "    \"F1-score\": [\n",
        "        0.7074,\n",
        "        0.6889,\n",
        "        0.7139\n",
        "    ],\n",
        "\n",
        "    \"ROC-AUC\": [\n",
        "        0.7327,\n",
        "        0.7203,\n",
        "        0.7464\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nBASELINE MODEL PERFORMANCE\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "display(\n",
        "    final_performance_summary.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Final Logistic Regression coefficient interpretation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "final_coefficients = pd.DataFrame({\n",
        "\n",
        "    \"Predictor\": [\n",
        "        \"Frequency\",\n",
        "        \"AverageOrderValue\",\n",
        "        \"UniqueProducts\",\n",
        "        \"Recency\",\n",
        "        \"MonetaryValue\"\n",
        "    ],\n",
        "\n",
        "    \"Coefficient\": [\n",
        "        1.2319,\n",
        "        0.4014,\n",
        "        0.3525,\n",
        "        -0.2374,\n",
        "        -0.6593\n",
        "    ]\n",
        "})\n",
        "\n",
        "final_coefficients[\"Direction\"] = np.where(\n",
        "    final_coefficients[\"Coefficient\"] > 0,\n",
        "    \"Positive\",\n",
        "    \"Negative\"\n",
        ")\n",
        "\n",
        "final_coefficients[\"AbsoluteEffect\"] = (\n",
        "    final_coefficients[\"Coefficient\"].abs()\n",
        ")\n",
        "\n",
        "final_coefficients = final_coefficients.sort_values(\n",
        "    \"AbsoluteEffect\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(\"\\nFINAL LOGISTIC REGRESSION PREDICTOR EFFECTS\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "display(\n",
        "    final_coefficients[\n",
        "        [\n",
        "            \"Predictor\",\n",
        "            \"Coefficient\",\n",
        "            \"Direction\"\n",
        "        ]\n",
        "    ].round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Random Forest feature importance summary\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_final_importance = pd.DataFrame({\n",
        "\n",
        "    \"Predictor\": [\n",
        "        \"MonetaryValue\",\n",
        "        \"Recency\",\n",
        "        \"AverageOrderValue\",\n",
        "        \"UniqueProducts\",\n",
        "        \"Frequency\"\n",
        "    ],\n",
        "\n",
        "    \"Importance\": [\n",
        "        0.2585,\n",
        "        0.2293,\n",
        "        0.2058,\n",
        "        0.2055,\n",
        "        0.1008\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nRANDOM FOREST FEATURE IMPORTANCE\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "display(\n",
        "    rf_final_importance.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Gradient Boosting feature importance summary\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gb_final_importance = pd.DataFrame({\n",
        "\n",
        "    \"Predictor\": [\n",
        "        \"Frequency\",\n",
        "        \"Recency\",\n",
        "        \"UniqueProducts\",\n",
        "        \"MonetaryValue\",\n",
        "        \"AverageOrderValue\"\n",
        "    ],\n",
        "\n",
        "    \"Importance\": [\n",
        "        0.5623,\n",
        "        0.1469,\n",
        "        0.1205,\n",
        "        0.1061,\n",
        "        0.0642\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nGRADIENT BOOSTING FEATURE IMPORTANCE\")\n",
        "print(\"-\" * 75)\n",
        "\n",
        "display(\n",
        "    gb_final_importance.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Key analytical findings\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nKEY ANALYTICAL FINDINGS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    \"1. The cleaned dataset contained 392,692 valid \"\n",
        "    \"transactions from 4,338 customers.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"2. A temporal cut-off created 3,370 eligible customers \"\n",
        "    \"with historical purchasing information.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"3. Of these customers, 1,921 (57.0%) made at least one \"\n",
        "    \"repeat purchase during the subsequent 90-day period.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"4. Logistic Regression achieved 66.62% accuracy, \"\n",
        "    \"70.65% precision, 70.83% recall, 70.74% F1-score \"\n",
        "    \"and 73.27% ROC-AUC.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"5. Gradient Boosting achieved the highest baseline \"\n",
        "    \"ROC-AUC at 74.64%, showing modestly stronger \"\n",
        "    \"discrimination than Logistic Regression.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"6. Five-fold cross-validation showed Logistic Regression \"\n",
        "    \"had the highest mean ROC-AUC at approximately 74.98%.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"7. Hyperparameter tuning did not improve held-out \"\n",
        "    \"generalisation. The tuned Logistic Regression produced \"\n",
        "    \"extreme repeat-class predictions and lower test ROC-AUC.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"8. Baseline Logistic Regression was therefore retained \"\n",
        "    \"as the final interpretable model.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"9. Frequency emerged as a particularly influential \"\n",
        "    \"predictor across Logistic Regression and Gradient Boosting.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"10. Recency, product diversity, spending behaviour and \"\n",
        "    \"average order value also contributed predictive information.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Business interpretation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nBUSINESS INTERPRETATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    \"Customers with stronger historical purchasing activity \"\n",
        "    \"showed a greater likelihood of purchasing again within \"\n",
        "    \"the 90-day prediction period.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Purchase frequency was especially informative, suggesting \"\n",
        "    \"that retailers could prioritise customers with established \"\n",
        "    \"repeat transaction patterns when designing retention campaigns.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Recency also provided meaningful predictive information, \"\n",
        "    \"indicating that the timing of previous purchases can support \"\n",
        "    \"customer targeting decisions.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"The results also show that more complex machine-learning \"\n",
        "    \"models do not automatically provide superior or more stable \"\n",
        "    \"predictive performance.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"The final Logistic Regression model offers a practical \"\n",
        "    \"balance between predictive discrimination and managerial \"\n",
        "    \"interpretability.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Methodological limitations\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nKEY LIMITATIONS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    \"- The analysis uses historical transactions from one \"\n",
        "    \"online retail dataset.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"- Results may not generalise directly to other retailers, \"\n",
        "    \"markets or time periods.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"- Predictive associations should not be interpreted as \"\n",
        "    \"causal relationships.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"- The 90-day prediction horizon represents one specific \"\n",
        "    \"operational definition of repeat purchasing.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"- Customer demographic and marketing-interaction variables \"\n",
        "    \"were unavailable.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Final completion message\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "\n",
        "print(\n",
        "    \"ANALYSIS COMPLETE — ALL CORE DATA PREPARATION, \"\n",
        "    \"MODELLING, VALIDATION, DIAGNOSTIC AND INTERPRETATION \"\n",
        "    \"STAGES HAVE BEEN COMPLETED.\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 75)"
      ],
