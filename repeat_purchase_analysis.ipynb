n\": \"\"\n      }\n    },\n    {\n      \"column\": \"ROC_AUC\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.013055394798064593,\n        \"min\": 0.7203,\n        \"max\": 0.7464,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.7327,\n          0.7203\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
