    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 8: Define observation and 90-day prediction periods\n",
        "# ============================================================\n",
        "\n",
        "prediction_start = pd.Timestamp(\"2011-09-10 00:00:00\")\n",
        "prediction_end = pd.Timestamp(\"2011-12-09 23:59:59\")\n",
        "\n",
        "# Historical transactions used to construct predictors\n",
        "observation_df = df_clean[\n",
        "    df_clean[\"InvoiceDate\"] < prediction_start\n",
        "].copy()\n",
        "\n",
        "# Future transactions used only to construct the target\n",
        "prediction_df = df_clean[\n",
        "    (df_clean[\"InvoiceDate\"] >= prediction_start) &\n",
        "    (df_clean[\"InvoiceDate\"] <= prediction_end)\n",
        "].copy()\n",
        "\n",
        "print(\"TEMPORAL PREDICTION DESIGN\")\n",
        "print(\"-\" * 45)\n",
        "\n",
        "print(\"Observation period:\")\n",
        "print(\" Start:\", observation_df[\"InvoiceDate\"].min())\n",
        "print(\" End:\", observation_df[\"InvoiceDate\"].max())\n",
        "print(\" Transactions:\", len(observation_df))\n",
        "print(\" Customers:\", observation_df[\"CustomerID\"].nunique())\n",
        "\n",
        "print(\"\\nPrediction period:\")\n",
        "print(\" Start:\", prediction_df[\"InvoiceDate\"].min())\n",
        "print(\" End:\", prediction_df[\"InvoiceDate\"].max())\n",
        "print(\" Transactions:\", len(prediction_df))\n",
        "print(\" Customers:\", prediction_df[\"CustomerID\"].nunique())\n",
        "\n",
        "# Verify that there is no temporal overlap\n",
        "print(\"\\nTemporal overlap:\",\n",
        "      observation_df[\"InvoiceDate\"].max() >= prediction_df[\"InvoiceDate\"].min())"
      ],
