    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 5: Remove invalid Quantity and UnitPrice values\n",
        "# ============================================================\n",
        "\n",
        "rows_before_invalid = len(df_clean)\n",
        "\n",
        "# Identify records with non-positive quantity or price\n",
        "invalid_quantity = (df_clean[\"Quantity\"] <= 0).sum()\n",
        "invalid_unitprice = (df_clean[\"UnitPrice\"] <= 0).sum()\n",
        "\n",
        "invalid_mask = (\n",
        "    (df_clean[\"Quantity\"] <= 0) |\n",
        "    (df_clean[\"UnitPrice\"] <= 0)\n",
        ")\n",
        "\n",
        "invalid_records = invalid_mask.sum()\n",
        "\n",
        "print(\"Records before validity filtering:\", rows_before_invalid)\n",
        "print(\"Records with Quantity <= 0:\", invalid_quantity)\n",
        "print(\"Records with UnitPrice <= 0:\", invalid_unitprice)\n",
        "print(\"Total records failing validity criteria:\", invalid_records)\n",
        "\n",
        "# Retain only valid purchases\n",
        "df_clean = df_clean[\n",
        "    (df_clean[\"Quantity\"] > 0) &\n",
        "    (df_clean[\"UnitPrice\"] > 0)\n",
        "].copy()\n",
        "\n",
        "print(\"\\nRecords after validity filtering:\", len(df_clean))\n",
        "print(\"Records removed at this stage:\", rows_before_invalid - len(df_clean))"
      ],
