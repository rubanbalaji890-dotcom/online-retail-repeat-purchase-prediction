        "# ============================================================\n",
        "# STEP 25: FINAL RESULTS VISUALISATIONS\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    roc_curve,\n",
        "    roc_auc_score,\n",
        "    confusion_matrix,\n",
        "    ConfusionMatrixDisplay\n",
        ")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"FINAL RESULTS VISUALISATIONS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. ROC CURVES FOR THE THREE BASELINE MODELS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "models_roc = {\n",
        "    \"Logistic Regression\": (\n",
        "        logistic_probabilities,\n",
        "        0.7327\n",
        "    ),\n",
        "    \"Random Forest\": (\n",
        "        rf_probabilities,\n",
        "        0.7203\n",
        "    ),\n",
        "    \"Gradient Boosting\": (\n",
        "        gb_probabilities,\n",
        "        0.7464\n",
        "    )\n",
        "}\n",
        "\n",
        "for model_name, (probabilities, auc_value) in models_roc.items():\n",
        "\n",
        "    fpr, tpr, _ = roc_curve(\n",
        "        y_test,\n",
        "        probabilities\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        fpr,\n",
        "        tpr,\n",
        "        linewidth=2,\n",
        "        label=f\"{model_name} (AUC = {auc_value:.3f})\"\n",
        "    )\n",
        "\n",
        "plt.plot(\n",
        "    [0, 1],\n",
        "    [0, 1],\n",
        "    linestyle=\"--\",\n",
        "    linewidth=1\n",
        ")\n",
        "\n",
        "plt.xlabel(\"False Positive Rate\")\n",
        "plt.ylabel(\"True Positive Rate\")\n",
        "\n",
        "plt.title(\n",
        "    \"ROC Curves for Repeat-Purchase Prediction Models\"\n",
        ")\n",
        "\n",
        "plt.legend(loc=\"lower right\")\n",
        "plt.grid(alpha=0.25)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. FINAL BASELINE LOGISTIC REGRESSION CONFUSION MATRIX\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "baseline_cm = np.array([\n",
        "    [177, 113],\n",
        "    [112, 272]\n",
        "])\n",
        "\n",
        "disp = ConfusionMatrixDisplay(\n",
        "    confusion_matrix=baseline_cm,\n",
        "    display_labels=[\n",
        "        \"Non-Repeat\",\n",
        "        \"Repeat\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 6))\n",
        "\n",
        "disp.plot(\n",
        "    ax=ax,\n",
        "    values_format=\"d\"\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Confusion Matrix – Final Logistic Regression Model\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. MODEL PERFORMANCE COMPARISON\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "performance = pd.DataFrame({\n",
        "\n",
        "    \"Logistic Regression\": [\n",
        "        0.6662,\n",
        "        0.7065,\n",
        "        0.7083,\n",
        "        0.7074,\n",
        "        0.7327\n",
        "    ],\n",
        "\n",
        "    \"Random Forest\": [\n",
        "        0.6543,\n",
        "        0.7068,\n",
        "        0.6719,\n",
        "        0.6889,\n",
        "        0.7203\n",
        "    ],\n",
        "\n",
        "    \"Gradient Boosting\": [\n",
        "        0.6766,\n",
        "        0.7196,\n",
        "        0.7083,\n",
        "        0.7139,\n",
        "        0.7464\n",
        "    ]\n",
        "\n",
        "}, index=[\n",
        "    \"Accuracy\",\n",
        "    \"Precision\",\n",
        "    \"Recall\",\n",
        "    \"F1-score\",\n",
        "    \"ROC-AUC\"\n",
        "])\n",
        "\n",
        "ax = performance.plot(\n",
        "    kind=\"bar\",\n",
        "    figsize=(10, 6)\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Performance Comparison of Repeat-Purchase Prediction Models\"\n",
        ")\n",
        "\n",
        "plt.ylabel(\"Score\")\n",
        "plt.xlabel(\"Evaluation Metric\")\n",
        "\n",
        "plt.ylim(0, 1)\n",
        "\n",
        "plt.xticks(\n",
        "    rotation=0\n",
        ")\n",
        "\n",
        "plt.legend(\n",
        "    title=\"Model\",\n",
        "    loc=\"lower right\"\n",
        ")\n",
        "\n",
        "plt.grid(\n",
        "    axis=\"y\",\n",
        "    alpha=0.25\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. LOGISTIC REGRESSION COEFFICIENTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "feature_names = [\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"MonetaryValue\",\n",
        "    \"UniqueProducts\",\n",
        "    \"AverageOrderValue\"\n",
        "]\n",
        "\n",
        "# Earlier baseline coefficients\n",
        "coefficient_values = [\n",
        "    -0.2374,\n",
        "    1.2319,\n",
        "    -0.6593,\n",
        "    0.3525,\n",
        "    0.4014\n",
        "]\n",
        "\n",
        "coefficient_df = pd.DataFrame({\n",
        "\n",
        "    \"Feature\": feature_names,\n",
        "    \"Coefficient\": coefficient_values\n",
        "\n",
        "})\n",
        "\n",
        "coefficient_df[\"Absolute_Effect\"] = (\n",
        "    coefficient_df[\"Coefficient\"].abs()\n",
        ")\n",
        "\n",
        "coefficient_df = coefficient_df.sort_values(\n",
        "    \"Coefficient\"\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(9, 6))\n",
        "\n",
        "plt.barh(\n",
        "    coefficient_df[\"Feature\"],\n",
        "    coefficient_df[\"Coefficient\"]\n",
        ")\n",
        "\n",
        "plt.axvline(\n",
        "    0,\n",
        "    linewidth=1\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Standardised Logistic Regression Coefficient\")\n",
        "\n",
        "plt.ylabel(\"Customer Behaviour Predictor\")\n",
        "\n",
        "plt.title(\n",
        "    \"Predictor Effects in the Final Logistic Regression Model\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. DISPLAY FINAL RESULTS TABLE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "final_results_table = pd.DataFrame({\n",
        "\n",
        "    \"Model\": [\n",
        "        \"Logistic Regression\",\n",
        "        \"Random Forest\",\n",
        "        \"Gradient Boosting\"\n",
        "    ],\n",
        "\n",
        "    \"Accuracy\": [\n",
        "        0.6662,\n",
        "        0.6543,\n",
        "        0.6766\n",
        "    ],\n",
        "\n",
        "    \"Precision\": [\n",
        "        0.7065,\n",
        "        0.7068,\n",
        "        0.7196\n",
        "    ],\n",
        "\n",
        "    \"Recall\": [\n",
        "        0.7083,\n",
        "        0.6719,\n",
        "        0.7083\n",
        "    ],\n",
        "\n",
        "    \"F1-score\": [\n",
        "        0.7074,\n",
        "        0.6889,\n",
        "        0.7139\n",
        "    ],\n",
        "\n",
        "    \"ROC-AUC\": [\n",
        "        0.7327,\n",
        "        0.7203,\n",
        "        0.7464\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nFINAL BASELINE MODEL RESULTS\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "display(final_results_table.round(4))\n",
        "\n",
        "print(\"\\nFINAL SELECTED MODEL\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "print(\"Baseline Logistic Regression\")\n",
        "\n",
        "print(\n",
        "    \"\\nFinal visualisation stage completed successfully.\"\n",
        ")"
