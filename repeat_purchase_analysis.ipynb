    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# STEP 22: HYPERPARAMETER TUNING\n",
        "# Logistic Regression + Gradient Boosting\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.model_selection import GridSearchCV, StratifiedKFold\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import GradientBoostingClassifier\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Stratified CV strategy\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "tuning_cv = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART A: LOGISTIC REGRESSION TUNING\n",
        "# ============================================================\n",
        "\n",
        "logistic_pipeline = Pipeline([\n",
        "    (\n",
        "        \"scaler\",\n",
        "        StandardScaler()\n",
        "    ),\n",
        "    (\n",
        "        \"model\",\n",
        "        LogisticRegression(\n",
        "            max_iter=2000,\n",
        "            random_state=42\n",
        "        )\n",
        "    )\n",
        "])\n",
        "\n",
        "\n",
        "logistic_param_grid = {\n",
        "    \"model__C\": [\n",
        "        0.01,\n",
        "        0.1,\n",
        "        1,\n",
        "        10,\n",
        "        100\n",
        "    ],\n",
        "\n",
        "    \"model__penalty\": [\n",
        "        \"l1\",\n",
        "        \"l2\"\n",
        "    ],\n",
        "\n",
        "    \"model__solver\": [\n",
        "        \"liblinear\"\n",
        "    ],\n",
        "\n",
        "    \"model__class_weight\": [\n",
        "        None,\n",
        "        \"balanced\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "\n",
        "logistic_grid = GridSearchCV(\n",
        "    estimator=logistic_pipeline,\n",
        "    param_grid=logistic_param_grid,\n",
        "    scoring=\"roc_auc\",\n",
        "    cv=tuning_cv,\n",
        "    n_jobs=-1,\n",
        "    refit=True,\n",
        "    return_train_score=False\n",
        ")\n",
        "\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"TUNING LOGISTIC REGRESSION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "logistic_grid.fit(\n",
        "    X_train_processed,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nBest Logistic Regression parameters:\")\n",
        "print(logistic_grid.best_params_)\n",
        "\n",
        "print(\n",
        "    \"\\nBest Logistic Regression CV ROC-AUC:\",\n",
        "    round(logistic_grid.best_score_, 4)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART B: GRADIENT BOOSTING TUNING\n",
        "# ============================================================\n",
        "\n",
        "gb_tuning_model = GradientBoostingClassifier(\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "gb_param_grid = {\n",
        "\n",
        "    \"n_estimators\": [\n",
        "        50,\n",
        "        100,\n",
        "        150,\n",
        "        200\n",
        "    ],\n",
        "\n",
        "    \"learning_rate\": [\n",
        "        0.03,\n",
        "        0.05,\n",
        "        0.1\n",
        "    ],\n",
        "\n",
        "    \"max_depth\": [\n",
        "        2,\n",
        "        3,\n",
        "        4\n",
        "    ],\n",
        "\n",
        "    \"min_samples_split\": [\n",
        "        2,\n",
        "        5,\n",
        "        10\n",
        "    ],\n",
        "\n",
        "    \"min_samples_leaf\": [\n",
        "        1,\n",
        "        3,\n",
        "        5\n",
        "    ]\n",
        "}\n",
        "\n",
        "\n",
        "gb_grid = GridSearchCV(\n",
        "    estimator=gb_tuning_model,\n",
        "    param_grid=gb_param_grid,\n",
        "    scoring=\"roc_auc\",\n",
        "    cv=tuning_cv,\n",
        "    n_jobs=-1,\n",
        "    refit=True,\n",
        "    return_train_score=False\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"TUNING GRADIENT BOOSTING\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "gb_grid.fit(\n",
        "    X_train_processed,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nBest Gradient Boosting parameters:\")\n",
        "print(gb_grid.best_params_)\n",
        "\n",
        "print(\n",
        "    \"\\nBest Gradient Boosting CV ROC-AUC:\",\n",
        "    round(gb_grid.best_score_, 4)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART C: COMPARE OPTIMISED MODELS\n",
        "# ============================================================\n",
        "\n",
        "tuning_comparison = pd.DataFrame({\n",
        "\n",
        "    \"Model\": [\n",
        "        \"Optimised Logistic Regression\",\n",
        "        \"Optimised Gradient Boosting\"\n",
        "    ],\n",
        "\n",
        "    \"Best_CV_ROC_AUC\": [\n",
        "        logistic_grid.best_score_,\n",
        "        gb_grid.best_score_\n",
        "    ]\n",
        "})\n",
        "\n",
        "\n",
        "tuning_comparison = tuning_comparison.sort_values(\n",
        "    \"Best_CV_ROC_AUC\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"OPTIMISED MODEL COMPARISON\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "display(\n",
        "    tuning_comparison.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PART D: SELECT FINAL CANDIDATE\n",
        "# ============================================================\n",
        "\n",
        "best_tuned_name = tuning_comparison.iloc[0][\"Model\"]\n",
        "\n",
        "best_tuned_auc = tuning_comparison.iloc[0][\n",
        "    \"Best_CV_ROC_AUC\"\n",
        "]\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"FINAL CANDIDATE FROM TRAINING DATA\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    \"Selected candidate:\",\n",
        "    best_tuned_name\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Cross-validated ROC-AUC:\",\n",
        "    round(best_tuned_auc, 4)\n",
        ")\n",
        "\n",
        "\n",
        "# Store fitted best estimators\n",
        "best_logistic_model = logistic_grid.best_estimator_\n",
        "best_gb_model = gb_grid.best_estimator_\n",
        "\n",
        "\n",
        "print(\"\\nTest set status:\")\n",
        "print(\n",
        "    \"The 674-customer test set has NOT been used \"\n",
        "    \"for hyperparameter selection.\"\n",
        ")\n",
        "\n",
        "print(\"\\nHyperparameter tuning completed successfully.\")"
      ],
