        "# ============================================================\n",
        "# Step 17: Predictor transformation and standardisation\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Create copies to preserve original train/test data\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "X_train_processed = X_train.copy()\n",
        "X_test_processed = X_test.copy()\n",
        "\n",
        "# Variables showing substantial positive skew\n",
        "log_features = [\n",
        "    \"Frequency\",\n",
        "    \"MonetaryValue\",\n",
        "    \"UniqueProducts\",\n",
        "    \"AverageOrderValue\"\n",
        "]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Log1p transformation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for feature in log_features:\n",
        "    X_train_processed[feature] = np.log1p(\n",
        "        X_train_processed[feature]\n",
        "    )\n",
        "\n",
        "    X_test_processed[feature] = np.log1p(\n",
        "        X_test_processed[feature]\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Compare training-set skewness before and after transform\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "skew_comparison = pd.DataFrame({\n",
        "    \"Original_Skew\": X_train[final_features].skew(),\n",
        "    \"Processed_Skew\":\n",
        "        X_train_processed[final_features].skew()\n",
        "})\n",
        "\n",
        "print(\"SKEWNESS BEFORE AND AFTER LOG TRANSFORMATION\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "display(skew_comparison.round(3))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Standardisation\n",
        "# Fit ONLY on training data to prevent data leakage\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_train_scaled = pd.DataFrame(\n",
        "    scaler.fit_transform(X_train_processed),\n",
        "    columns=final_features,\n",
        "    index=X_train_processed.index\n",
        ")\n",
        "\n",
        "X_test_scaled = pd.DataFrame(\n",
        "    scaler.transform(X_test_processed),\n",
        "    columns=final_features,\n",
        "    index=X_test_processed.index\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Verify standardisation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "scaling_check = pd.DataFrame({\n",
        "    \"Training_Mean\": X_train_scaled.mean(),\n",
        "    \"Training_SD\": X_train_scaled.std(ddof=0)\n",
        "})\n",
        "\n",
        "print(\"\\nSTANDARDISATION CHECK — TRAINING DATA\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "display(scaling_check.round(3))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Integrity checks\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nPREPROCESSING INTEGRITY CHECK\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(\"Training shape:\", X_train_scaled.shape)\n",
        "print(\"Test shape:\", X_test_scaled.shape)\n",
        "\n",
        "print(\n",
        "    \"Missing values in processed training data:\",\n",
        "    X_train_scaled.isna().sum().sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Missing values in processed test data:\",\n",
        "    X_test_scaled.isna().sum().sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Infinite values in training data:\",\n",
        "    np.isinf(X_train_scaled.to_numpy()).sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Infinite values in test data:\",\n",
        "    np.isinf(X_test_scaled.to_numpy()).sum()\n",
        ")\n",
        "\n",
        "print(\"\\nScaler fitted using training data only.\")\n",
        "print(\"Preprocessing completed successfully.\")"
      ],
