        "\n",
        "original_rows = len(df)\n",
        "\n",
        "missing_customerid = df[\"CustomerID\"].isna().sum()\n",
        "\n",
        "print(\"\\nOriginal transaction records:\", original_rows)\n",
        "print(\"Records with missing CustomerID:\", missing_customerid)\n",
        "\n",
        "df_clean = df[df[\"CustomerID\"].notna()].copy()\n",
        "\n",
        "print(\"Records remaining after removing missing CustomerID:\", len(df_clean))\n",
        "print(\"Records removed:\", original_rows - len(df_clean))"
      ],
