      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 4: Remove cancelled transactions\n",
        "# ============================================================\n",
        "\n",
        "rows_before_cancellation = len(df_clean)\n",
        "\n",
        "# Cancelled invoices in the UCI dataset begin with \"C\"\n",
        "cancelled_mask = (\n",
        "    df_clean[\"InvoiceNo\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.upper()\n",
        "    .str.startswith(\"C\")\n",
        ")\n",
        "\n",
        "cancelled_records = cancelled_mask.sum()\n",
        "\n",
        "print(\"Records before removing cancellations:\", rows_before_cancellation)\n",
        "print(\"Cancelled transaction records:\", cancelled_records)\n",
        "\n",
        "df_clean = df_clean[~cancelled_mask].copy()\n",
        "\n",
        "print(\"Records after removing cancellations:\", len(df_clean))\n",
        "print(\"Records removed at this stage:\", rows_before_cancellation - len(df_clean))"
      ],
