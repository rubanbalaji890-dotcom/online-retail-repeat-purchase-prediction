      "source": [
        "# ============================================================\n",
        "# Step 15: Resolve multicollinearity and re-check VIF\n",
        "# ============================================================\n",
        "\n",
        "# Remove BasketSize because of severe multicollinearity\n",
        "# with AverageOrderValue (correlation ≈ 0.968)\n",
        "\n",
        "final_features = [\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"MonetaryValue\",\n",
        "    \"UniqueProducts\",\n",
        "    \"AverageOrderValue\"\n",
        "]\n",
        "\n",
        "X_reduced = model_df[final_features].copy()\n",
        "\n",
        "# Add constant for VIF calculation\n",
        "X_reduced_const = add_constant(X_reduced)\n",
        "\n",
        "revised_vif = pd.DataFrame()\n",
        "\n",
        "revised_vif[\"Feature\"] = X_reduced_const.columns\n",
        "\n",
        "revised_vif[\"VIF\"] = [\n",
        "    variance_inflation_factor(X_reduced_const.values, i)\n",
        "    for i in range(X_reduced_const.shape[1])\n",
        "]\n",
        "\n",
        "# Remove intercept\n",
        "revised_vif = revised_vif[\n",
        "    revised_vif[\"Feature\"] != \"const\"\n",
        "].copy()\n",
        "\n",
