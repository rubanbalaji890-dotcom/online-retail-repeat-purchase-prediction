        "# ============================================================\n",
        "# Step 19: Random Forest Classifier\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Initialise Random Forest\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_model = RandomForestClassifier(\n",
        "    n_estimators=300,\n",
        "    max_depth=None,\n",
        "    min_samples_split=2,\n",
        "    min_samples_leaf=1,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Train model\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_model.fit(\n",
        "    X_train_scaled,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Generate predictions\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_predictions = rf_model.predict(\n",
        "    X_test_scaled\n",
        ")\n",
        "\n",
        "rf_probabilities = rf_model.predict_proba(\n",
        "    X_test_scaled\n",
        ")[:, 1]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Performance metrics\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_accuracy = accuracy_score(\n",
        "    y_test,\n",
        "    rf_predictions\n",
        ")\n",
        "\n",
        "rf_precision = precision_score(\n",
        "    y_test,\n",
        "    rf_predictions\n",
        ")\n",
        "\n",
        "rf_recall = recall_score(\n",
        "    y_test,\n",
        "    rf_predictions\n",
        ")\n",
        "\n",
        "rf_f1 = f1_score(\n",
        "    y_test,\n",
        "    rf_predictions\n",
        ")\n",
        "\n",
        "rf_roc_auc = roc_auc_score(\n",
        "    y_test,\n",
        "    rf_probabilities\n",
        ")\n",
        "\n",
        "\n",
        "print(\"RANDOM FOREST — TEST PERFORMANCE\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"Accuracy:  {rf_accuracy:.4f}\")\n",
        "print(f\"Precision: {rf_precision:.4f}\")\n",
        "print(f\"Recall:    {rf_recall:.4f}\")\n",
        "print(f\"F1-score:  {rf_f1:.4f}\")\n",
        "print(f\"ROC-AUC:   {rf_roc_auc:.4f}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Confusion matrix\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_cm = confusion_matrix(\n",
        "    y_test,\n",
        "    rf_predictions\n",
        ")\n",
        "\n",
        "rf_cm_df = pd.DataFrame(\n",
        "    rf_cm,\n",
        "    index=[\n",
        "        \"Actual Non-Repeat\",\n",
        "        \"Actual Repeat\"\n",
        "    ],\n",
        "    columns=[\n",
        "        \"Predicted Non-Repeat\",\n",
        "        \"Predicted Repeat\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"\\nCONFUSION MATRIX\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "display(rf_cm_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Classification report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nCLASSIFICATION REPORT\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(\n",
        "    classification_report(\n",
        "        y_test,\n",
        "        rf_predictions,\n",
        "        target_names=[\n",
        "            \"Non-Repeat\",\n",
        "            \"Repeat\"\n",
        "        ],\n",
        "        digits=4\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Feature importance\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rf_importance = pd.DataFrame({\n",
        "    \"Feature\": final_features,\n",
        "    \"Importance\": rf_model.feature_importances_\n",
        "})\n",
        "\n",
        "rf_importance = rf_importance.sort_values(\n",
        "    \"Importance\",\n",
        "    ascending=False\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(\"\\nRANDOM FOREST FEATURE IMPORTANCE\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "display(\n",
        "    rf_importance.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Compare with Logistic Regression\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model_comparison = pd.DataFrame({\n",
        "    \"Model\": [\n",
        "        \"Logistic Regression\",\n",
        "        \"Random Forest\"\n",
        "    ],\n",
        "\n",
        "    \"Accuracy\": [\n",
        "        log_accuracy,\n",
        "        rf_accuracy\n",
        "    ],\n",
        "\n",
        "    \"Precision\": [\n",
        "        log_precision,\n",
        "        rf_precision\n",
        "    ],\n",
        "\n",
        "    \"Recall\": [\n",
        "        log_recall,\n",
        "        rf_recall\n",
        "    ],\n",
        "\n",
        "    \"F1\": [\n",
        "        log_f1,\n",
        "        rf_f1\n",
        "    ],\n",
        "\n",
        "    \"ROC_AUC\": [\n",
        "        log_roc_auc,\n",
        "        rf_roc_auc\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"\\nMODEL COMPARISON\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "display(\n",
        "    model_comparison.round(4)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Prediction integrity check\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nRANDOM FOREST PREDICTION CHECK\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "print(\"Test customers:\", len(y_test))\n",
        "\n",
        "print(\n",
        "    \"Predicted repeat purchasers:\",\n",
        "    int((rf_predictions == 1).sum())\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Predicted non-repeat purchasers:\",\n",
        "    int((rf_predictions == 0).sum())\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Prediction probability range:\",\n",
        "    round(rf_probabilities.min(), 4),\n",
        "    \"to\",\n",
        "    round(rf_probabilities.max(), 4)\n",
        ")\n",
        "\n",
        "print(\"\\nRandom Forest completed successfully.\")"
      ],
