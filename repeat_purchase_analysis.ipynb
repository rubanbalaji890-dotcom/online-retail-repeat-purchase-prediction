    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Step 9: Create 90-day repeat-purchase target\n",
        "# ============================================================\n",
        "\n",
        "# Customers eligible for modelling:\n",
        "# they must have purchasing history in the observation period\n",
        "eligible_customers = pd.DataFrame({\n",
        "    \"CustomerID\": observation_df[\"CustomerID\"].unique()\n",
        "})\n",
        "\n",
        "# Customers who made at least one purchase in the prediction period\n",
        "future_customers = set(prediction_df[\"CustomerID\"].unique())\n",
        "\n",
        "# Target:\n",
        "# 1 = customer purchased again during prediction period\n",
        "# 0 = customer did not purchase again\n",
        "eligible_customers[\"RepeatPurchase90D\"] = (\n",
        "    eligible_customers[\"CustomerID\"]\n",
        "    .isin(future_customers)\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "print(\"90-DAY REPEAT-PURCHASE TARGET\")\n",
        "print(\"-\" * 45)\n",
        "\n",
        "print(\"Eligible modelling customers:\",\n",
        "      len(eligible_customers))\n",
        "\n",
        "print(\"Repeat purchasers:\",\n",
        "      eligible_customers[\"RepeatPurchase90D\"].sum())\n",
        "\n",
        "print(\"Non-repeat purchasers:\",\n",
        "      (eligible_customers[\"RepeatPurchase90D\"] == 0).sum())\n",
        "\n",
        "print(\"\\nTarget distribution:\")\n",
        "print(\n",
        "    eligible_customers[\"RepeatPurchase90D\"]\n",
        "    .value_counts()\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "print(\"\\nTarget percentages:\")\n",
        "print(\n",
        "    eligible_customers[\"RepeatPurchase90D\"]\n",
        "    .value_counts(normalize=True)\n",
        "    .sort_index()\n",
        "    .mul(100)\n",
        "    .round(2)\n",
        ")\n",
        "\n",
        "print(\"\\nTarget check:\")\n",
        "print(\n",
        "    eligible_customers[\"RepeatPurchase90D\"]\n",
        "    .value_counts()\n",
        "    .sum()\n",
        ")"
      ],
